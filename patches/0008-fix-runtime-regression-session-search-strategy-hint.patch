From bb3e7e70203ca04e572cb529f1047b6cc533b0fa Mon Sep 17 00:00:00 2001
From: Cyrene963 <Nitrogen@users.noreply.github.com>
Date: Thu, 14 May 2026 23:47:00 +0800
Subject: [PATCH] fix: runtime regression - _list_recent_sessions user_id +
 StrategyHint type safety

1. session_search_tool.py: _list_recent_sessions() now accepts user_id param
   and passes it to db.list_sessions_rich(). Fixes TypeError when session_search
   called without query (recent sessions mode) in multi-user isolation context.

2. run_agent.py: StrategyHint object was being assigned to _strategy_hint which
   is later used in f-string concatenation. Now explicitly checks type to ensure
   string compatibility while preserving StrategyHint attribute access.

Regression tests: 5/5 passed (user_id compat, StrategyHint f-string, concatenation)
---
 run_agent.py                 | 3 ++-
 tools/session_search_tool.py | 3 ++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/run_agent.py b/run_agent.py
index cbdaf8c80..7bdda0048 100644
--- a/run_agent.py
+++ b/run_agent.py
@@ -12170,7 +12170,8 @@ class AIAgent:
             from agent.memory_metacognition import build_strategy_preflight
             _sr_uc = {"user_id": self._user_id, "chat_id": self._chat_id} if getattr(self, '_user_id', None) else None
             _strat = build_strategy_preflight(user_context=_sr_uc)
-            _strategy_hint = _strat.check(user_message or "") or ""
+            _strat_result = _strat.check(user_message or "")
+            _strategy_hint = _strat_result if isinstance(_strat_result, str) else (_strat_result or "")
         except Exception:
             pass
 
diff --git a/tools/session_search_tool.py b/tools/session_search_tool.py
index 144b08b03..9cf58f929 100644
--- a/tools/session_search_tool.py
+++ b/tools/session_search_tool.py
@@ -273,13 +273,14 @@ async def _summarize_session(
 _HIDDEN_SESSION_SOURCES = ("tool",)
 
 
-def _list_recent_sessions(db, limit: int, current_session_id: str = None) -> str:
+def _list_recent_sessions(db, limit: int, current_session_id: str = None, user_id: str = None) -> str:
     """Return metadata for the most recent sessions (no LLM calls)."""
     try:
         sessions = db.list_sessions_rich(
             limit=limit + 5,
             exclude_sources=list(_HIDDEN_SESSION_SOURCES),
             order_by_last_active=True,
+            user_id=user_id,
         )  # fetch extra to skip current
 
         # Resolve current session lineage to exclude it
-- 
