--- /dev/null
+++ b/web/src/types/xterm.d.ts
@@ -0,0 +1,102 @@
+declare module "@xterm/xterm" {
+  export interface ITerminalOptions {
+    fontSize?: number;
+    lineHeight?: number;
+    fontFamily?: string;
+    theme?: Record<string, string>;
+    cursorBlink?: boolean;
+    cursorStyle?: string;
+    scrollback?: number;
+    tabStopWidth?: number;
+    allowProposedApi?: boolean;
+    allowTransparency?: boolean;
+    [key: string]: unknown;
+  }
+
+  export interface ITerminalAddon {
+    activate(terminal: Terminal): void;
+    dispose(): void;
+  }
+
+  export class Terminal {
+    constructor(options?: ITerminalOptions);
+    open(element: HTMLElement): void;
+    write(data: string | Uint8Array): void;
+    writeln(data: string | Uint8Array): void;
+    clear(): void;
+    reset(): void;
+    focus(): void;
+    blur(): void;
+    selectAll(): void;
+    select(
+      column: number,
+      row: number,
+      length: number,
+    ): void;
+    getSelection(): string;
+    getSelectionPosition(): { start: number; end: number } | undefined;
+    clearSelection(): void;
+    paste(text: string): void;
+    refresh(startRow: number, endRow: number): void;
+    resize(columns: number, rows: number): void;
+    loadAddon(addon: ITerminalAddon): void;
+    scrollLines(amount: number): void;
+    scrollPages(pageCount: number): void;
+    scrollToTop(): void;
+    scrollToBottom(): void;
+    scrollToLine(line: number): void;
+    clearTextureAtlas(): void;
+    dispose(): void;
+
+    onData(callback: (data: string) => void): { dispose: () => void };
+    onBinary(callback: (data: string) => void): { dispose: () => void };
+    onCursorMove(callback: () => void): { dispose: () => void };
+    onLineFeed(callback: () => void): { dispose: () => void };
+    onScroll(callback: (yoffset: number) => void): { dispose: () => void };
+    onSelectionChange(callback: () => void): { dispose: () => void };
+    onRender(
+      callback: (event: { start: number; end: number }) => void,
+    ): { dispose: () => void };
+    onResize(
+      callback: (event: { cols: number; rows: number }) => void,
+    ): { dispose: () => void };
+    onTitleChange(callback: (title: string) => void): { dispose: () => void };
+    onBell(callback: () => void): { dispose: () => void };
+
+    attachCustomKeyEventHandler(
+      callback: (event: KeyboardEvent) => boolean,
+    ): void;
+
+    parser: {
+      registerOscHandler(
+        number: number,
+        handler: (data: string) => void,
+      ): { dispose: () => void };
+    };
+
+    unicode: {
+      activeVersion: string;
+      versions: string[];
+      getStringCellWidth(s: string): number;
+    };
+
+    buffer: {
+      active: {
+        cursorX: number;
+        cursorY: number;
+        viewportY: number;
+        baseY: number;
+        length: number;
+        getLine(y: number): {
+          translateToString(trimRight?: boolean, startColumn?: number, endColumn?: number): string;
+        } | undefined;
+      };
+    };
+
+    element?: HTMLElement;
+    textarea?: HTMLTextAreaElement;
+    cols: number;
+    rows: number;
+    options: ITerminalOptions;
+  }
+}
