[Unit]
Description=Hermes Memory Graph Server
Documentation=https://hermes-agent.nousresearch.com/docs
After=network-online.target postgresql@15-main.service hindsight.service
Wants=network-online.target postgresql@15-main.service hindsight.service
PartOf=hermes-memory-stack.target

[Service]
Type=simple
WorkingDirectory=/root/.hermes/hermes-agent
EnvironmentFile=-/root/.hermes/.env
Environment=PYTHONUNBUFFERED=1
Environment=HERMES_HOME=/root/.hermes
ExecStart=/root/.hermes/hermes-agent/venv/bin/python -m agent.memory_graph.server --host 127.0.0.1 --port 8900
Restart=always
RestartSec=5
TimeoutStartSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
