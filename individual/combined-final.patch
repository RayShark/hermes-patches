+            }
         target_path = os.path.join(
             os.path.expanduser("~"), ".hermes", "memory_policy.yaml"
         )
@@ -909,10 +946,13 @@ def apply_suggestion(suggestion: LessonSuggestion,
             "dry_run": dry_run,
