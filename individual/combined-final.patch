+    _critical = frozenset(
+        {Path("/etc"), Path("/var"), Path("/usr"), Path("/home"),
+         Path("/root"), Path("/opt"), Path("/tmp")}
+    )
+    if d in _critical:
+        return
+    try:
+        os.chmod(d, 0o700)
+    except OSError:
+        pass
