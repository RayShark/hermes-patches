+    def _format_history_message_for_context(self, message: Message) -> Optional[str]:
+        text = getattr(message, "text", None) or getattr(message, "caption", None) or ""
+        text = str(text).strip()
+        if not text:
+            if getattr(message, "photo", None):
+                text = "(photo)"
+            elif getattr(message, "video", None):
+                text = "(video)"
+            elif getattr(message, "document", None):
+                text = "(document)"
+            elif getattr(message, "audio", None):
+                text = "(audio)"
+            elif getattr(message, "voice", None):
+                text = "(voice)"
+            elif getattr(message, "sticker", None):
+                text = "(sticker)"
+        if not text:
+            return None
+
+        from_user = getattr(message, "from_user", None)
+        sender = (
+            getattr(from_user, "full_name", None)
+            or getattr(from_user, "username", None)
+            or getattr(getattr(message, "sender_chat", None), "title", None)
+            or "Unknown"
+        )
+        if from_user is not None and getattr(from_user, "is_bot", False):
+            sender = f"{sender} [bot]"
+        return f"[{sender}] {text}"
