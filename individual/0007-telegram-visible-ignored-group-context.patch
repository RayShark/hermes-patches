+    def _telegram_history_backfill(self) -> bool:
+        """Return whether group trigger messages should fetch recent chat context."""
+        configured = self.config.extra.get("history_backfill")
+        if configured is not None:
+            if isinstance(configured, str):
+                return configured.lower() in {"true", "1", "yes", "on"}
+            return bool(configured)
+        return os.getenv("TELEGRAM_HISTORY_BACKFILL", "false").lower() in {"true", "1", "yes", "on"}
+
+    def _telegram_history_backfill_limit(self) -> int:
+        raw = self.config.extra.get("history_backfill_limit")
+        if raw is None:
+            raw = os.getenv("TELEGRAM_HISTORY_BACKFILL_LIMIT", "20")
+        try:
+            return max(0, int(raw))
+        except (TypeError, ValueError):
+            return 20
+
+    def _telegram_context_cache_limit(self) -> int:
+        raw = self.config.extra.get("context_cache_limit")
